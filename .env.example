# توكن البوت من BotFather
BOT_TOKEN=123456789:AAExampleTokenHere

# رابط صفحة الاستبيان بعد رفعها (GitHub Pages أو Render Static Site)
WEBAPP_URL=https://username.github.io/baghdida-festival/

# رابط تطبيق Render العام (يُستخدم فقط لإعداد الـ Webhook مرة واحدة)
PUBLIC_URL=https://your-app-name.onrender.com

# معرف الشيت (من رابط Google Sheet، الجزء بين /d/ و /edit)
SHEET_ID=1AbCDefGhIJKLmnoPQRstuVWXyz

# محتوى ملف حساب الخدمة (JSON) بشكل نصي كامل على سطر واحد
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "...": "..."}

# أرقام (User ID) الأدمنز المسموح لهم بالتبليغ الجماعي، مفصولة بفاصلة
ADMIN_IDS=111111111,222222222

# اختياري: جزء سري لمسار الـ Webhook (افتراضياً يستخدم التوكن نفسه)
WEBHOOK_SECRET_PATH=baghdida-secret-2026
